{
  "format_version": 1,
  "plates": [
    {
      "id": "rows",
      "kind": "rows",
      "label": "Rows"
    }
  ],
  "nodes": [
    {
      "id": "y",
      "kind": "data",
      "name": "y",
      "label": "Outcome (a count)",
      "plate": "rows",
      "type": "int",
      "support": "nonnegative"
    },
    {
      "id": "x",
      "kind": "data",
      "name": "x",
      "label": "Predictor",
      "plate": "rows",
      "type": "real",
      "standardize": true
    },
    {
      "id": "alpha",
      "kind": "parameter",
      "name": "alpha",
      "label": "Intercept",
      "plate": null,
      "prior": {
        "dist": "normal",
        "args": {
          "mu": {
            "expr": "0"
          },
          "sigma": {
            "expr": "2.5"
          }
        }
      }
    },
    {
      "id": "bx",
      "kind": "parameter",
      "name": "b_x",
      "label": "Effect of the predictor",
      "plate": null,
      "prior": {
        "dist": "normal",
        "args": {
          "mu": {
            "expr": "0"
          },
          "sigma": {
            "expr": "2.5"
          }
        }
      }
    },
    {
      "id": "phi",
      "kind": "parameter",
      "name": "phi",
      "label": "Extra variation of the count",
      "plate": null,
      "prior": {
        "dist": "inv_gamma",
        "args": {
          "alpha": {
            "expr": "0.4"
          },
          "beta": {
            "expr": "0.3"
          }
        }
      }
    },
    {
      "id": "eta",
      "kind": "linear_predictor",
      "name": "eta",
      "label": "Expected outcome",
      "plate": "rows",
      "intercept": {
        "expr": "alpha"
      },
      "terms": [
        {
          "data": "x",
          "coef": {
            "expr": "b_x"
          }
        }
      ]
    },
    {
      "id": "lik",
      "kind": "likelihood",
      "label": "Count given the predictor",
      "observed": "y",
      "dist": "neg_binomial_2_log",
      "args": {
        "eta": {
          "expr": "eta"
        },
        "phi": {
          "expr": "phi"
        }
      }
    }
  ],
  "layout": {
    "alpha": {
      "x": 0,
      "y": 0
    },
    "bx": {
      "x": 220,
      "y": 0
    },
    "x": {
      "x": 220,
      "y": 140
    },
    "eta": {
