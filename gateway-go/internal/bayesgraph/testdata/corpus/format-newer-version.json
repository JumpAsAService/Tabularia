{
  "name": "format-newer-version",
  "rule": "graph.format",
  "expect": "trips",
  "raw": "{\"format_version\":2,\"plates\":[],\"nodes\":[]}",
  "findings": [
    {
      "code": "graph.format",
      "severity": "error",
      "args": {
        "detail": "format_version 2 is newer than the 1 this gateway reads",
        "version": 2
      }
    }
  ]
}
