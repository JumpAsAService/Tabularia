    },
    {
      "id": "delta",
      "kind": "parameter",
      "name": "delta",
      "label": "Drift: the average step",
      "plate": null,
      "prior": {
        "dist": "normal",
        "args": {
          "mu": {
            "expr": "0"
          },
          "sigma": {
            "expr": "0.02"
          }
        }
      }
    },
    {
      "id": "sigma",
      "kind": "parameter",
      "name": "sigma",
      "label": "Spread of a step",
      "plate": null,
      "prior": {
        "dist": "exponential",
        "args": {
          "beta": {
            "expr": "1 / 0.02"
          }
        }
      }
    },
    {
      "id": "lik",
      "kind": "likelihood",
      "label": "Series given its last value",
      "observed": "y",
      "dist": "normal",
      "args": {
        "mu": {
          "expr": "lag(y, 1) + delta"
        },
        "sigma": {
          "expr": "sigma"
        }
      }
    }
