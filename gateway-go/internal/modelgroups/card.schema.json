{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tabularia.org/schemas/model-card/1",
  "title": "Tabularia model card",
  "description": "model.json: everything needed to apply a fitted model to new rows, as data, never as code (docs/specs/statistical-models.md, «The model card»). Written by a group's runner (common/R/card.R, common/py/tab_card.py) in fit mode; read by Tabularia to log and register the model, and by the runner in predict mode. A card is at most 1 MiB: vcov is written up to 200 terms, Cox's baseline hazard at most 5,000 times per stratum.",
  "type": "object",
  "required": ["format", "format_version", "model", "variant", "group", "group_version", "recipe_hash", "runner_hash",
               "software", "created_at", "params", "inputs"],
  "properties": {
    "format": {"const": "tabularia-model"},
    "format_version": {"const": 1},
    "model": {"enum": ["linear", "logistic", "kaplan_meier", "cox", "parametric_survival", "arima", "garch", "xgboost", "catboost", "clv", "bg_bb", "bayes_model"]},
    "variant": {"type": "string", "minLength": 1},
    "group": {"enum": ["regression", "survival", "timeseries", "boosting", "customer_lifetime", "bayes"]},
    "group_version": {"type": ["integer", "string"]},
    "recipe_hash": {"type": "string"},
    "runner_hash": {"type": "string"},
    "software": {"type": "object", "description": "the language (R or Python) and the packages, with their versions", "minProperties": 1, "additionalProperties": {"type": "string"}},
    "created_at": {"type": "string", "description": "UTC, ISO 8601"},
    "params": {"type": "object", "description": "the node's parameters, as the catalogue's check answered them"},
    "formula": {"type": "string", "description": "in symbols, with the columns' names: for people, never parsed"},
    "outcome": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string"},
        "event_value": {"description": "logistic and survival: the value that is the event"}
      }
    },
    "inputs": {
      "type": "array",
      "description": "the columns Predict needs, of the same kind",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "type": {"enum": ["number", "category", "time"]},
          "levels": {"type": "array", "items": {"type": "string"}, "description": "a category's levels: a regression's with the reference first; a boosting model's in text order, in the order of its codes"},
          "reference": {"type": "string"}
        },
        "allOf": [{"if": {"properties": {"type": {"const": "category"}}}, "then": {"required": ["levels"]}}]
      }
    },
    "terms": {
      "type": "array",
      "description": "the columns of the design, in the order of `coefficients`: as the results' coef rows name them (level, level_2)",
      "items": {
        "type": "object",
        "required": ["term", "level", "variables"],
        "properties": {
          "term": {"type": "string"},
          "level": {"type": ["string", "null"]},
          "variables": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "coefficients": {"type": "array", "items": {"type": ["number", "null"]}},
    "vcov": {"type": ["array", "null"], "items": {"type": "array", "items": {"type": ["number", "null"]}}},
    "link": {"enum": ["identity", "logit", "probit", "log"]},
    "threshold": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "alpha": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "linear": {
      "type": "object",
      "required": ["sigma", "df_residual"],
      "properties": {"sigma": {"type": "number"}, "df_residual": {"type": "number"}}
    },
    "penalty": {
      "type": "object",
      "required": ["penalty", "lambda", "mixing"],
      "properties": {
        "penalty": {"enum": ["ridge", "lasso", "elastic_net"]},
        "lambda": {"type": "number"},
        "mixing": {"type": "number"},
        "standardize": {"type": "boolean"}
      }
    },
    "cox": {
      "type": "object",
      "required": ["centring", "baseline"],
      "properties": {
        "centring": {"type": "array", "items": {"type": "number"}, "description": "the means the linear predictor is centred on, per term"},
        "strata": {"type": ["string", "null"], "description": "the strata column"},
        "baseline": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["stratum", "time", "cumhaz"],
            "properties": {
              "stratum": {"type": ["string", "null"]},
              "time": {"type": "array", "items": {"type": "number"}, "maxItems": 5000},
              "cumhaz": {"type": "array", "items": {"type": "number"}, "maxItems": 5000}
            }
          }
        }
      }
    },
    "kaplan_meier": {
      "type": "object",
      "required": ["strata"],
      "properties": {
        "strata_column": {"type": ["string", "null"]},
        "tolerance": {"type": "number", "minimum": 0, "description": "0: every event time; above, the most the card's curve and interval differ from the fit's"},
        "strata": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["stratum", "time", "surv"],
            "properties": {
              "stratum": {"type": ["string", "null"]},
              "time": {"type": "array", "items": {"type": "number"}},
              "surv": {"type": "array", "items": {"type": "number"}},
              "lower": {"type": "array", "items": {"type": ["number", "null"]}},
              "upper": {"type": "array", "items": {"type": ["number", "null"]}}
            }
          }
        }
      }
    },
    "parametric_survival": {
      "type": "object",
      "description": "a parametric survival model's: the distribution, which element of `coefficients` is which, and the columns of the time and the event. A few dozen numbers, never a row: with `terms`, `coefficients`, `vcov` and `inputs` it is all Predict needs (flexsurv's p, q and h functions of the distribution, the delta method with vcov for the intervals)",
      "required": ["distribution", "selection", "coefficient_scale", "parameters", "location", "transforms", "order", "time_column",
                   "event_column", "event_value", "last_time", "quantiles", "times", "alpha", "flexsurv"],
      "properties": {
        "distribution": {"enum": ["weibull", "exponential", "lognormal", "loglogistic", "gengamma", "gompertz"], "description": "the one fitted (with selection auto, the one chosen)"},
        "selection": {"enum": ["manual", "auto"]},
        "coefficient_scale": {"enum": ["log_time_ratio", "log_hazard_ratio"]},
        "parameters": {"type": "array", "items": {"type": "string"}, "description": "flexsurv's names of the distribution's parameters, in flexsurv's order (that of the first elements of `coefficients`: shape, scale for the Weibull; meanlog, sdlog for the log-normal)"},
        "location": {"type": "string", "description": "the parameter the predictors act on"},
        "transforms": {"type": "array", "items": {"enum": ["identity", "log"]}, "description": "the scale on which the optimiser moves each parameter, in the order of `parameters`"},
        "order": {
          "type": "array",
          "description": "what each element of `coefficients` is: the distribution's own parameters, the location's terms (by their position in `terms`, from 1, or a stratum's effect), the strata's shapes",
          "items": {
            "type": "object",
            "required": ["role"],
            "properties": {
              "role": {"enum": ["parameter", "location", "anc"]},
              "name": {"type": "string"},
              "term": {"type": "integer", "minimum": 1},
              "stratum": {"type": "string"}
            }
          }
        },
        "strata": {
          "type": ["object", "null"],
          "properties": {"column": {"type": "string"}, "levels": {"type": "array", "items": {"type": "string"}}}
        },
        "time_column": {"type": "string"},
        "event_column": {"type": "string"},
        "event_value": {"description": "the value of the event column that is an event"},
        "start_column": {"type": ["string", "null"], "description": "the column of the delayed entry the model was fitted with (left truncation), or null: Predict does not read it, the parameters already hold it"},
        "last_time": {"type": "number", "description": "the last time observed when fitting: a prediction beyond it is an extrapolation"},
        "last_time_by_stratum": {
          "description": "the last time observed in each stratum, one number per level in the order of `strata.levels` (one number, the last time, without strata). Cards written before 2026-11-21 hold an object by level, or null without strata: Predict still reads them",
          "oneOf": [
            {"type": "array", "minItems": 1, "items": {"type": "number"}},
            {"type": "object", "additionalProperties": {"type": "number"}},
            {"type": "null"}
          ]
        },
        "quantiles": {"type": "array", "maxItems": 9, "items": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}},
        "times": {"type": "array", "maxItems": 10, "items": {"type": "number", "minimum": 0}},
        "alpha": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "flexsurv": {"type": "string", "description": "the version of flexsurv that fitted it"}
      }
    },
    "customer_lifetime": {
      "type": "object",
      "description": "a customer lifetime model's («buy till you die»): the purchase model's parameters and, with a spend column, Gamma–Gamma's, with the time unit, the horizon, the discount and the margin. A few dozen numbers, never a row and no serialized object: with `inputs` it is all Predict needs, computed by the runner with the same functions as the fit (docs/specs/customer-lifetime-models.md, «The saved model, MLflow and Predict»)",
      "required": ["node", "time_unit", "purchase_model", "chosen_by", "purchases", "horizon", "discount_rate", "periods_per_year", "margin", "library"],
      "properties": {
        "node": {"enum": ["clv", "bg_bb"]},
        "time_unit": {"enum": ["day", "week", "month", "quarter", "year"], "description": "the unit of the recency, the age and the horizon; BG/BB's opportunity"},
        "purchase_model": {"enum": ["pareto_nbd", "bg_nbd", "mbg_nbd", "bg_bb"], "description": "the one fitted (with `auto`, the one chosen)"},
        "chosen_by": {"enum": ["log_lik", "manual"]},
        "purchases": {
          "type": "object",
          "required": ["model", "params"],
          "properties": {
            "model": {"enum": ["pareto_nbd", "bg_nbd", "mbg_nbd", "bg_bb"]},
            "params": {"type": "object", "minProperties": 4, "additionalProperties": {"type": "number", "exclusiveMinimum": 0}, "description": "r, alpha, s, beta (Pareto/NBD); r, alpha, a, b (BG/NBD, MBG/NBD); alpha, beta, gamma, delta (BG/BB)"},
            "vcov_log": {"type": ["array", "null"], "items": {"type": "array", "items": {"type": "number"}}, "description": "the covariance of the log parameters; null when the Hessian was not positive definite"}
          }
        },
        "spend": {
          "type": ["object", "null"],
          "description": "Gamma–Gamma, in the variant `value`; null without a spend column",
          "required": ["model", "params"],
          "properties": {
            "model": {"const": "gamma_gamma"},
            "params": {"type": "object", "required": ["p", "q", "gamma"], "additionalProperties": {"type": "number", "exclusiveMinimum": 0}},
            "vcov_log": {"type": ["array", "null"], "items": {"type": "array", "items": {"type": "number"}}}
          }
        },
        "horizon": {"type": "integer", "minimum": 1, "description": "periods ahead, in `time_unit`"},
        "discount_rate": {"type": "number", "minimum": 0, "maximum": 1, "description": "annual"},
        "periods_per_year": {"type": "number", "exclusiveMinimum": 0, "description": "365.25, 365.25/7, 12, 4 or 1: how the annual rate becomes a rate per period"},
        "margin": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "library": {"type": "object", "required": ["CLVTools", "gsl"], "additionalProperties": {"type": "string"}, "description": "the versions that fitted it"}
      }
    },
    "arima": {
      "type": "object",
      "required": ["orders", "frequency", "coefficients", "last"],
      "properties": {
        "orders": {
          "type": "object",
          "required": ["p", "d", "q", "P", "D", "Q", "s"],
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "frequency": {"type": "string"},
        "coefficients": {"type": "object", "additionalProperties": {"type": "number"}},
        "sigma2": {"type": "number"},
        "transform": {"enum": ["none", "log", "box_cox"]},
        "box_cox_lambda": {"type": ["number", "null"]},
        "drift": {"type": "boolean"},
        "mean": {"type": "boolean"},
        "exog": {"type": "array", "items": {"type": "string"}},
        "last": {"type": "object", "description": "the last observations, residuals and times the filter needs to forecast"}
      }
    },
    "garch": {
      "type": "object",
      "description": "a volatility model's: the specification, the parameters on the series' units, and the state the filter continues from (the last returns, residuals, variances or log-variances, standardized residuals, the last price)",
      "required": ["variance_model", "arch_order", "garch_order", "ar_order", "ma_order", "mean", "distribution", "input_kind", "var_level",
                   "frequency", "coefficients", "last"],
      "properties": {
        "variance_model": {"enum": ["arch", "garch", "gjr", "egarch"]},
        "arch_order": {"type": "integer", "minimum": 1},
        "garch_order": {"type": "integer", "minimum": 0},
        "ar_order": {"type": "integer", "minimum": 0},
        "ma_order": {"type": "integer", "minimum": 0},
        "mean": {"type": "boolean"},
        "distribution": {"enum": ["norm", "std", "sstd"]},
        "input_kind": {"enum": ["returns", "prices"]},
        "returns_type": {"enum": ["log", "simple"]},
        "var_level": {"type": "number", "exclusiveMinimum": 0.5, "exclusiveMaximum": 1},
        "var_quantile": {"type": "number", "description": "the fitted law's quantile at 1 − var_level: VaR = μ + σ·var_quantile"},
        "frequency": {"type": "string"},
        "coefficients": {"type": "object", "additionalProperties": {"type": "number"}},
        "last": {"type": "object", "required": ["time_kind", "time", "returns", "residuals", "z"],
                 "description": "the state at the last instant: the series' units, oldest first"}
      }
    },
    "boosting": {
      "type": "object",
      "description": "a boosting model's: the library, the task, the classes, and the model file beside the card (XGBoost's JSON, CatBoost's cbm: data the library parses, never code), tied to the card by its sha256",
      "required": ["library", "library_version", "task", "objective", "classes", "event_value", "threshold", "trees", "best_iteration",
                   "threads", "missing_level", "model_file"],
      "properties": {
        "library": {"enum": ["xgboost", "catboost"]},
        "library_version": {"type": "string"},
        "task": {"enum": ["regression", "binary", "multiclass"]},
        "objective": {"type": "string", "description": "the library's name of the loss: binary:logistic, Logloss…"},
        "classes": {"type": "array", "items": {"type": "string"}, "description": "the outcome's labels in text order, the class index 0…k − 1 (empty for a regression)"},
        "event_value": {"type": ["string", "null"], "description": "binary: the class whose probability is predicted"},
        "threshold": {"type": ["number", "null"], "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "trees": {"type": "integer", "minimum": 0, "description": "the boosting rounds kept"},
        "best_iteration": {"type": "integer", "minimum": 0, "description": "from 0"},
        "threads": {"type": "integer", "minimum": 1},
        "missing_level": {"type": ["string", "null"], "description": "CatBoost: the text a missing category becomes"},
        "model_file": {
          "type": "object",
          "required": ["name", "format", "bytes", "sha256"],
          "properties": {
            "name": {"enum": ["xgboost.json", "catboost.cbm"]},
            "format": {"enum": ["xgboost-json", "catboost-cbm"]},
            "bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    },
    "bayes": {
      "type": "object",
      "description": "a Bayesian model run's: the saved model and its pinned version, the program's and the compiled binary's hashes, what each quantity stands for, the bound data and their standardization, the units of each plate, the sampler as run, the facts of the sampler and the scalar quantities' summary. Never a draw",
      "required": ["model", "program", "binary", "mapping", "data", "units", "sampler", "facts", "summary"],
      "properties": {
        "model": {
          "type": "object",
          "required": ["id", "version", "semantic_hash", "codegen_version"],
          "properties": {
            "id": {"type": "integer"},
            "version": {"type": "integer", "minimum": 1},
            "semantic_hash": {"type": "string"},
            "codegen_version": {"type": "integer"}
          }
        },
        "program": {
          "type": "object",
          "required": ["sha256", "bytes"],
          "properties": {
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "bytes": {"type": "integer", "minimum": 0}
          }
        },
        "binary": {
          "type": "object",
          "required": ["sha256", "cmdstan", "image"],
          "properties": {
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "cmdstan": {"type": "string"},
            "image": {"type": "string"}
          }
        },
        "mapping": {
          "type": "array",
          "description": "a quantity's Stan identifier and what it stands for: the node, its name, its label",
          "items": {
            "type": "object",
            "required": ["stan", "node_id", "name", "label", "kind"],
            "properties": {
              "stan": {"type": "string"},
              "node_id": {"type": "string"},
              "name": {"type": ["string", "null"]},
              "label": {"type": ["string", "null"]},
              "kind": {"enum": ["parameter", "transformed", "state", "effect", "correlation"]}
            }
          }
        },
        "data": {
          "type": "array",
          "description": "a bound data variable: its column, and the mean and sd it was standardized with",
          "items": {
            "type": "object",
            "required": ["stan", "column", "standardized"],
            "properties": {
              "stan": {"type": "string"},
              "column": {"type": "string"},
              "standardized": {"type": "boolean"},
              "mean": {"type": "number"},
              "sd": {"type": "number"}
            }
          }
        },
        "units": {
          "type": "object",
          "description": "each plate: its units' count and their labels (cut first when the card is too large; the count stays)",
          "additionalProperties": {
            "type": "object",
            "required": ["count", "labels"],
            "properties": {
              "count": {"type": "integer", "minimum": 0},
              "labels": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "sampler": {
          "type": "object",
          "required": ["algorithm", "chains", "warmup", "draws", "seed", "adapt_delta", "max_treedepth"],
          "properties": {
            "algorithm": {"enum": ["nuts", "fixed_param"]},
            "chains": {"type": "integer", "minimum": 1},
            "warmup": {"type": "integer", "minimum": 0},
            "draws": {"type": "integer", "minimum": 1},
            "seed": {"type": "integer", "minimum": 0},
            "adapt_delta": {"type": "number"},
            "max_treedepth": {"type": "integer", "minimum": 1}
          }
        },
        "facts": {
          "type": "object",
          "description": "the sampler's facts over the chains: counts and a measure, never a verdict",
          "required": ["divergences", "treedepth_hits", "e_bfmi_min"],
          "properties": {
            "divergences": {"type": "integer", "minimum": 0},
            "treedepth_hits": {"type": "integer", "minimum": 0},
            "e_bfmi_min": {"type": ["number", "null"]}
          }
        },
        "summary": {
          "type": "array",
          "description": "the scalar quantities' summary (cut first when the card is too large)",
          "items": {
            "type": "object",
            "required": ["quantity"],
            "properties": {
              "quantity": {"type": "string"},
              "mean": {"type": ["number", "null"]},
              "sd": {"type": ["number", "null"]},
              "q5": {"type": ["number", "null"]},
              "q50": {"type": ["number", "null"]},
              "q95": {"type": ["number", "null"]},
              "rhat": {"type": ["number", "null"]},
              "ess_bulk": {"type": ["number", "null"]},
              "ess_tail": {"type": ["number", "null"]}
            }
          }
        }
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"model": {"enum": ["linear", "logistic", "cox", "parametric_survival"]}}},
     "then": {"required": ["terms", "coefficients"]}},
    {"if": {"properties": {"model": {"enum": ["linear", "logistic"]}}}, "then": {"required": ["link"]}},
    {"if": {"properties": {"model": {"const": "linear"}, "variant": {"const": "unpenalized"}}}, "then": {"required": ["linear"]}},
    {"if": {"properties": {"variant": {"const": "penalized"}}}, "then": {"required": ["penalty"]}},
    {"if": {"properties": {"model": {"const": "logistic"}}}, "then": {"required": ["threshold", "outcome"]}},
    {"if": {"properties": {"model": {"const": "cox"}}}, "then": {"required": ["cox", "outcome"]}},
    {"if": {"properties": {"model": {"const": "kaplan_meier"}}}, "then": {"required": ["kaplan_meier", "outcome"]}},
    {"if": {"properties": {"model": {"const": "parametric_survival"}}}, "then": {"required": ["parametric_survival", "outcome"]}},
    {"if": {"properties": {"model": {"const": "arima"}}}, "then": {"required": ["arima"]}},
    {"if": {"properties": {"model": {"const": "garch"}}}, "then": {"required": ["garch"]}},
    {"if": {"properties": {"model": {"enum": ["clv", "bg_bb"]}}}, "then": {"required": ["customer_lifetime"]}},
    {"if": {"properties": {"group": {"const": "boosting"}}, "required": ["group"]},
     "then": {"required": ["boosting"], "properties": {"software": {"required": ["Python"]}}},
     "else": {"properties": {"software": {"required": ["R"]},
                             "inputs": {"items": {"if": {"properties": {"type": {"const": "category"}}}, "then": {"required": ["reference"]}}}}}},
    {"if": {"properties": {"model": {"const": "bayes_model"}}}, "then": {"required": ["bayes"]}}
  ]
}
