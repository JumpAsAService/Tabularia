# TruffleHog as used by the release workflow and by the pre-push guard: one place, so
# the two cannot drift apart. Read by both with plain KEY=value parsing, no shell.
TRUFFLEHOG_IMAGE=trufflesecurity/trufflehog:3.97.9@sha256:52e67fef4d054ecff5c2ce4b4ae376626d1ef54aa0898b53cac19c25e92e14db
# credentials of cloud providers and of the services this project touches: for these
# even a failed verification stops the release or the push (a live key behind a network
# error must not slip through); for every other detector only a verified secret does
CLOUD_DETECTORS=AWS,AWSSessionKey,GCP,GCPApplicationDefaultCredentials,GoogleOauth2,GoogleGeminiAPIKey,Azure,AzureStorage,AzureBatch,AzureContainerRegistry,AzureActiveDirectoryApplicationSecret,AzureDevopsPersonalAccessToken,AzureSasToken,AzureSQL,AzureOpenAI,AzureRefreshToken,ScalewayKey,DigitalOceanToken,DigitalOceanV2,DigitalOceanSpaces,Alibaba,TencentCloudKey,IbmCloudUserKey,Linode,VultrApiKey,CloudflareApiToken,CloudflareGlobalApiKey,CloudflareCaKey,DatabricksToken,Snowflake,Github,GitHubApp,GitHubOauth2,Gitlab,GitLabOauth2,Dockerhub,Docker,Heroku,HuggingFace,OpenAI,OpenAIAdmin,Anthropic
