{
  "prefix": "stat_",
  "families": [
    "means",
    "variances",
    "proportions",
    "correlation",
    "ranks",
    "distributions"
  ],
  "controls": [
    "column",
    "levels",
    "boolean",
    "number",
    "choice",
    "level",
    "proportions"
  ],
  "kinds": {
    "column": {
      "control": "column"
    },
    "number_column": {
      "control": "column",
      "numeric": true
    },
    "two_groups": {
      "control": "levels",
      "of": "group",
      "count": 2
    },
    "boolean": {
      "control": "boolean"
    },
    "number": {
      "control": "number"
    },
    "positive": {
      "control": "number",
      "above": 0
    },
    "alpha": {
      "control": "number",
      "above": 0,
      "below": 1
    },
    "alternative": {
      "control": "choice",
      "choices": [
        "two_sided",
        "less",
        "greater"
      ]
    },
    "anova_posthoc": {
      "control": "choice",
      "choices": [
        "none",
        "tukey",
        "games_howell",
        "pairwise_t"
      ]
    },
    "p_adjust": {
      "control": "choice",
      "choices": [
        "holm",
        "bonferroni",
        "sidak",
        "none"
      ]
    },
    "levene_center": {
      "control": "choice",
      "choices": [
        "median",
        "mean"
      ]
    },
    "proportion": {
      "control": "number",
      "above": 0,
      "below": 1
    },
    "success": {
      "control": "level",
      "of": "value"
    },
    "prop_method": {
      "control": "choice",
      "choices": [
        "score",
        "exact"
      ]
    },
    "chi2_posthoc": {
      "control": "choice",
      "choices": [
        "none",
        "cells",
        "pairs"
      ]
    },
    "g_posthoc": {
      "control": "choice",
      "choices": [
        "none",
        "cells"
      ]
    },
    "mcnemar_method": {
      "control": "choice",
      "choices": [
        "auto",
        "exact",
        "asymptotic"
      ]
    },
    "rank_method": {
      "control": "choice",
      "choices": [
        "auto",
        "exact",
        "asymptotic"
      ]
    },
    "wilcoxon_zeros": {
      "control": "choice",
      "choices": [
        "wilcox",
        "pratt"
      ]
    },
    "kw_posthoc": {
      "control": "choice",
      "choices": [
        "none",
        "dunn"
      ]
    },
    "ks_method": {
      "control": "choice",
      "choices": [
        "auto",
        "exact",
        "asymptotic"
      ]
    },
    "normality_method": {
      "control": "choice",
      "choices": [
        "dagostino",
        "jarque_bera"
      ]
    },
    "expected_proportions": {
      "control": "proportions",
      "of": "value"
    },
    "detail": {
      "control": "choice",
      "choices": [
        "results",
        "report"
      ],
      "hidden": true
    }
  },
  "tests": [
    {
      "id": "t_one_sample",
      "operation": "stat_t_one_sample",
      "family": "means",
      "needs": {
        "value": "number_column"
      },
      "takes": {
        "mu": "number",
        "alternative": "alternative",
        "alpha": "alpha",
        "detail": "detail"
      },
      "defaults": {
        "mu": 0.0,
        "alternative": "two_sided",
        "alpha": 0.05,
        "detail": "results"
      },
      "forbids": [],
      "applies": {}
    },
    {
      "id": "t_two_sample",
      "operation": "stat_t_two_sample",
      "family": "means",
      "needs": {
        "value": "number_column",
        "group": "column"
      },
      "takes": {
        "groups": "two_groups",
        "var_equal": "boolean",
        "mu": "number",
        "alternative": "alternative",
        "alpha": "alpha",
        "detail": "detail"
      },
      "defaults": {
        "groups": null,
        "var_equal": false,
        "mu": 0.0,
        "alternative": "two_sided",
        "alpha": 0.05,
        "detail": "results"
      },
      "forbids": [],
      "applies": {}
    },
    {
      "id": "t_paired",
      "operation": "stat_t_paired",
      "family": "means",
      "needs": {
        "x": "number_column",
        "y": "number_column"
      },
      "takes": {
        "mu": "number",
        "alternative": "alternative",
        "alpha": "alpha",
        "detail": "detail"
      },
      "defaults": {
        "mu": 0.0,
        "alternative": "two_sided",
        "alpha": 0.05,
        "detail": "results"
      },
      "forbids": [],
      "applies": {}
    },
    {
      "id": "anova",
      "operation": "stat_anova",
      "family": "means",
      "needs": {
        "value": "number_column",
        "group": "column"
      },
      "takes": {
        "var_equal": "boolean",
        "posthoc": "anova_posthoc",
        "p_adjust": "p_adjust",
        "alpha": "alpha",
        "detail": "detail"
      },
      "defaults": {
        "var_equal": true,
        "posthoc": "none",
        "p_adjust": "holm",
        "alpha": 0.05,
        "detail": "results"
      },
      "forbids": [
        {
          "key": "posthoc",
          "value": "tukey",
          "when": {
            "var_equal": false
          },
          "reason": "tukey_equal_variances",
          "message": "Tukey's HSD assumes equal variances: with Welch's ANOVA (var_equal = false) use Games–Howell"
        },
        {
          "key": "posthoc",
          "value": "games_howell",
          "when": {
            "var_equal": true
          },
          "reason": "games_howell_unequal_variances",
          "message": "Games–Howell is for unequal variances: with the classic ANOVA (var_equal = true) use Tukey's HSD"
        }
      ],
      "applies": {
        "p_adjust": {
          "posthoc": [
            "pairwise_t"
          ]
        }
      }
    },
    {
      "id": "var_f",
      "operation": "stat_var_f",
      "family": "variances",
      "needs": {
        "value": "number_column",
        "group": "column"
      },
      "takes": {
        "groups": "two_groups",
        "ratio": "positive",
        "alternative": "alternative",
        "alpha": "alpha",
        "detail": "detail"
      },
      "defaults": {
        "groups": null,
        "ratio": 1.0,
        "alternative": "two_sided",
        "alpha": 0.05,
        "detail": "results"
      },
      "forbids": [],
      "applies": {}
    },
    {
      "id": "levene",
      "operation": "stat_levene",
      "family": "variances",
      "needs": {
        "value": "number_column",
        "group": "column"
      },
      "takes": {
        "center": "levene_center",
        "alpha": "alpha",
        "detail": "detail"
      },
      "defaults": {
        "center": "median",
        "alpha": 0.05,
        "detail": "results"
      },
      "forbids": [],
      "applies": {}
    },
    {
      "id": "prop_one_sample",
      "operation": "stat_prop_one_sample",
      "family": "proportions",
      "needs": {
        "value": "column",
        "success": "success"
      },
      "takes": {
        "p0": "proportion",
        "method": "prop_method",
        "correction": "boolean",
        "alternative": "alternative",
        "alpha": "alpha",
        "detail": "detail"
      },
      "defaults": {
        "p0": 0.5,
        "method": "score",
        "correction": true,
        "alternative": "two_sided",
        "alpha": 0.05,
        "detail": "results"
      },
      "forbids": [],
      "applies": {
        "correction": {
          "method": [
            "score"
          ]
        }
      }
    },
