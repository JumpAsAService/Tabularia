# syntax=docker/dockerfile:1.9
#
# The frontend's PRODUCTION image (Nuxt 3, server-side rendering with Nitro).
# `Dockerfile` stays for development: a dev server with hot reload and mounted
# sources, a model too different from a built app to share the image.
#
# One image for every environment: the public configuration entries are set
# AT START-UP through environment variables, without rebuilding:
#   NUXT_PUBLIC_API_BASE     the gateway's public URL, called by the browser
#   NUXT_PUBLIC_BUCKET       default bucket (must match STORAGE__BUCKET)
#   NUXT_PUBLIC_GRAFANA_URL  Grafana as the browser sees it (Monitoring tab, optional)
# The Nuxt server never calls the API while rendering: every call starts from
# the browser, so the pod does not need to reach the gateway.
#
# Non-root user 10001 (like backend and gateway), read-only filesystem:
# the server writes no files, /tmp stays the only writable directory.

########################
#   Stage 1: build     #
########################
FROM node:22-alpine AS build

WORKDIR /build

ENV NUXT_TELEMETRY_DISABLED=1 \
    NODE_OPTIONS=--max-old-space-size=4096

# dependencies from the lockfile (cacheable layer)
COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --no-audit --no-fund

COPY . .
RUN npm run build

########################
#   Stage 2: runtime   #
########################
FROM node:22-alpine AS runtime
# Nuxt's server (.output) runs with `node` alone: the base image's npm, yarn and
# corepack are not needed and bring along dependencies with known
# vulnerabilities (pacote, sigstore, ip-address…) that scanners report.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
           /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
           /opt/yarn-* /usr/local/bin/yarn /usr/local/bin/yarnpkg

RUN addgroup -S -g 10001 app \
 && adduser -S -D -H -u 10001 -G app -s /sbin/nologin app

# HOST/PORT: where the Nitro server listens. HOME=/tmp: the user has no home.
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=3000 \
    TMPDIR=/tmp \
    HOME=/tmp \
    NUXT_TELEMETRY_DISABLED=1

WORKDIR /app

# Only the built app: Nitro puts in .output the dependencies it really uses
# (no full node_modules, no sources, no build tools).
COPY --from=build --chown=10001:10001 /build/.output ./.output

USER 10001:10001

EXPOSE 3000

CMD ["node", ".output/server/index.mjs"]
