# ── Secrets: NEVER commit ────────────────────────────────────────────────────
infrastructure/.env
infrastructure/.env.*
!infrastructure/.env.example
# every environment file, wherever it is (gen-env.sh writes
# infrastructure/production/.env with every production secret); examples stay tracked
.env
.env.*
*.env
!.env.example
!*.env.example
!.github/scripts/trufflehog.env
backend/app/config/secrets.toml
*.pem
*.key

# ── Local data files (never ship datasets with the repo) ─────────────────────
*.csv
*.xlsx
*.parquet
# … but the small synthetic tables of the statistical models' self-test and reference cases
# (docs/specs/statistical-models.md, «Reference values»: tens to hundreds of rows)
!gateway-go/internal/modelgroups/common/selftest/*.csv
!gateway-go/internal/modelgroups/groups/*/reference/data/*.csv

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# ── Node / Nuxt ──────────────────────────────────────────────────────────────
node_modules/
frontend/.nuxt/
frontend/.output/
frontend/public/third-party-notices.txt
website/public/third-party-notices.txt
frontend/dist/
npm-debug.log*
yarn-error.log*

# ── Runtime artifacts ────────────────────────────────────────────────────────
celerybeat-schedule*
*.log
*.tmp

# ── OS / IDE ─────────────────────────────────────────────────────────────────
.DS_Store
.vscode/
.idea/
.claude/settings.local.json
infrastructure/gcp_keys.json

# ── e2e oracles: the exported projects and the logs (e2e/dbt_export/README.md) ─
e2e/dbt_export/.work/
