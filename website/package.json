{
  "name": "tabularia-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Tabularia presentation site and documentation (static, GitHub Pages)",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "pregenerate": "node ../frontend/scripts/third-party-notices.mjs public/third-party-notices.txt --extra \"IBM Plex Sans|OFL-1.1|../frontend/assets/fonts/OFL.txt\"",
    "generate": "nuxt generate",
    "preview": "node scripts/serve.mjs",
    "check-links": "node scripts/check-links.mjs",
    "postinstall": "nuxt prepare",
    "clean": "node -e \"for (const d of ['.data','.nuxt','.output']) require('node:fs').rmSync(d,{recursive:true,force:true})\"",
    "test": "node --experimental-strip-types --test tests/placeholders.test.ts tests/os-tabs.test.ts tests/code-copy.test.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@nuxt/content": "3.16.2",
    "github-slugger": "2.0.0",
    "lucide-vue-next": "1.0.0",
    "minisearch": "7.2.0",
    "nuxt": "4.6.2",
    "vue": "3.5.44"
  },
  "packageManager": "npm@11.21.1",
  "allowScripts": {
    "esbuild": true
  }
}
