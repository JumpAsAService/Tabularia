# ─────────────────────────────────────────────────────────────────────────────
# Tabularia — environment configuration
# Copy to `.env` and adjust. NEVER commit the real `.env`.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

APP__ENV_NAME=development
APP__DEBUG=true
# Timezone del deployment per lo SCHEDULING: le espressioni cron sono interpretate
# in questo fuso (orario a parete locale, DST incluso), es. '0 3 * * *' = 03:00
# locali. NON tocca la visualizzazione dei timestamp (resta nel fuso del browser).
# Nome IANA. Default UTC.
# es. Europe/Rome
APP__TIMEZONE=UTC

# ── Flow orchestration ───────────────────────────────────────────────────────
# A flow waits for its Refresh/Output nodes to COMPLETE before running downstream
# steps, so ordering is real. Past the cap the flow aborts instead of reading
# stale data — raise these if you have very long refreshes/outputs (huge tables
# or slow networks). Values in seconds.
ORCHESTRATOR__REFRESH_WAIT_SECONDS=600
ORCHESTRATOR__OUTPUT_WAIT_SECONDS=600
ORCHESTRATOR__POLL_INTERVAL_SECONDS=3

# ── Broker / cache index (Valkey) ────────────────────────────────────────────
REDIS__HOST=redis
REDIS__PORT=6379
REDIS__DB=0

# ── Object storage (any S3-compatible endpoint: MinIO, AWS S3, R2, B2…) ─────
STORAGE__ENDPOINT=http://minio:9000
STORAGE__ACCESS_KEY=minioadmin
# change in production
STORAGE__SECRET_KEY=minioadmin
STORAGE__BUCKET=data-prep
STORAGE__REGION=us-east-1

# ── External ClickHouse engine (optional) ───────────────────────────────────
# Run flows on a remote ClickHouse server (cloud managed or self-hosted) instead
# of in the worker: same operations/dialect as chDB, but the work happens on the
# server. Disabled until HOST is set. Use the HTTP(S) port (8123 / 8443), NOT the
# native one (9000 / 9440).
#CLICKHOUSE_EXTERNAL__HOST=xxxx.datawarehouse.it-mil.scw.eu
#CLICKHOUSE_EXTERNAL__PORT=8443
#CLICKHOUSE_EXTERNAL__SECURE=true
#CLICKHOUSE_EXTERNAL__USERNAME=default
#CLICKHOUSE_EXTERNAL__PASSWORD=
# must exist; hosts staging tables in push mode
#CLICKHOUSE_EXTERNAL__DATABASE=default
# How the server reaches the data:
#   s3   → ClickHouse reads/writes parquet DIRECTLY on the object storage via s3():
#          nothing flows through the worker. Requires the storage to be reachable
#          from the server (e.g. ClickHouse + Object Storage on the same cloud).
#   push → the worker uploads the source into a staging table and streams the
#          result back: works with any ClickHouse, data transits the worker.
#CLICKHOUSE_EXTERNAL__TRANSPORT=s3
# Storage endpoint AS SEEN BY ClickHouse (s3 mode). Empty = STORAGE__ENDPOINT,
# which is right only when the server sits on the same network (http://minio:9000).
#CLICKHOUSE_EXTERNAL__S3_ENDPOINT=https://s3.fr-par.scw.cloud
# Optional: a named collection created ON THE SERVER with the S3 credentials, so
# keys never travel inside queries (nor end up in the query_log):
#   CREATE NAMED COLLECTION tabularia_s3 AS access_key_id = '…', secret_access_key = '…'
#CLICKHOUSE_EXTERNAL__S3_NAMED_COLLECTION=tabularia_s3
# Per-query execution cap in seconds (0 = none)
#CLICKHOUSE_EXTERNAL__MAX_EXECUTION_TIME=0

# ── Workers ──────────────────────────────────────────────────────────────────
CELERY__WORKER_CONCURRENCY=2

# ── Incremental step cache ───────────────────────────────────────────────────
# evict entries unused for 1 day
CACHE__TTL_SECONDS=86400
# eviction sweep every hour
CACHE__SWEEP_INTERVAL_SECONDS=3600

# ── Monitoring (Grafana admin) ───────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
# change in production
GRAFANA_ADMIN_PASSWORD=admin

# ── Metadata database (Postgres) ─────────────────────────────────────────────
DB__USER=tabularia
# change in production
DB__PASSWORD=tabularia
DB__NAME=tabularia
DB__HOST=postgres
DB__PORT=5432

# ── Auth (gateway) ───────────────────────────────────────────────────────────
# Generate a strong secret:  openssl rand -hex 32
# In production the gateway REFUSES to start with the dev defaults below.
JWT__SECRET=change-me-in-production
JWT__ACCESS_TTL_MINUTES=720

# Initial admin user, seeded at first startup (existing users are never touched)
AUTH__ADMIN_EMAIL=admin@tabularia.local
# change in production
AUTH__ADMIN_PASSWORD=admin
AUTH__ADMIN_NAME=Administrator

# ── SSO / OIDC (OPTIONAL: Keycloak, Microsoft Entra ID, Auth0, Okta…) ───────
# Leave OIDC__ISSUER empty to keep local email+password login only: the SSO
# routes stay off and the login page shows no SSO button. When set, the gateway
# self-configures from ${OIDC__ISSUER}/.well-known/openid-configuration and
# refuses to start if the rest of the block is incomplete.
# Runnable Keycloak example: docs/examples/keycloak/
#OIDC__ISSUER=http://localhost:8080/realms/tabularia
#   Entra ID: https://login.microsoftonline.com/<tenant-id>/v2.0
#OIDC__CLIENT_ID=tabularia-gateway
# confidential client, rotate for real use
#OIDC__CLIENT_SECRET=
# must match the IdP
#OIDC__REDIRECT_URI=http://localhost:8000/auth/sso/callback
# frontend landing page
#OIDC__POST_LOGIN_URL=http://localhost:3000/auth/callback
#OIDC__SCOPES=openid profile email
# 'roles' for Entra app roles
#OIDC__GROUPS_CLAIM=groups
# comma-separated; empty = every IdP group
#OIDC__GROUP_ALLOWLIST=
# false = map only onto existing groups
#OIDC__AUTO_CREATE_GROUPS=false
# true = the IdP owns group membership
#OIDC__AUTHORITATIVE=true
# membership grants is_superuser
#OIDC__SUPERUSER_GROUP=tabularia-admins
#OIDC__BUTTON_LABEL=Single sign-on

# ── Database-connection credentials encryption (gateway + engine) ───────────
# Shared Fernet key: the gateway encrypts DB-connection passwords at rest and
# sends them still encrypted to the engine, which decrypts them only inside the
# worker. REQUIRED in EVERY environment, development included: `docker compose up`
# refuses to start without it, and gateway/engine/workers refuse an invalid one.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECURITY__FERNET_KEY=

# ── Internal engine URL (data plane, proxied by the gateway) ─────────────────
ENGINE__BASE_URL=http://backend:8000
