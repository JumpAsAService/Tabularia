# ─────────────────────────────────────────────────────────────────────────────
# Tabularia — environment configuration
# Copy to `.env` and adjust. NEVER commit the real `.env`.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

APP__ENV_NAME=development
# Timezone del deployment per lo SCHEDULING: le espressioni cron sono interpretate
# in questo fuso (orario a parete locale, DST incluso), es. '0 3 * * *' = 03:00
# locali. NON tocca la visualizzazione dei timestamp (resta nel fuso del browser).
# Nome IANA. Default UTC.
# es. Europe/Rome
APP__TIMEZONE=UTC

# ── Automatic development sample ─────────────────────────────────────────────
# With a value > 0, every source node WITHOUT a sample of its own is read only
# for its first N rows in editor previews and trial runs ("development" mode).
# Users switch it off per node ("off (all rows)") or replace it with their own
# sample. Scheduled runs and "Run in production" always read everything.
# Useful when every read costs (remote object storage, pay-per-use warehouse).
# 0 or unset = no automatic sample (previous behaviour).
#PREVIEW__DEFAULT_SAMPLE_ROWS=100000

# ── Step-cache ───────────────────────────────────────────────────────────────
# The editor caches the output of intermediate steps so the next click restarts
# from there. The copy is written AFTER the preview answers (a separate task),
# and only for steps up to this many rows: a copy as large as the source gains
# nothing over re-reading the original parquet and costs gigabytes of writes
# (25M rows = 2.4 GB and 40 s on an external ClickHouse). Bigger steps are
# recomputed from the source. 0 = no cap.
#CACHE__MAX_STEP_ROWS=1000000

# ── Flow orchestration ───────────────────────────────────────────────────────
# A flow waits for its Refresh/Output nodes to COMPLETE before running downstream
# steps, so ordering is real. Past the cap the flow aborts instead of reading
# stale data — raise these if you have very long refreshes/outputs (huge tables
# or slow networks). Values in seconds.
ORCHESTRATOR__REFRESH_WAIT_SECONDS=600
ORCHESTRATOR__OUTPUT_WAIT_SECONDS=600
ORCHESTRATOR__POLL_INTERVAL_SECONDS=3

# ── Running the gateway as several processes ─────────────────────────────────
# The gateway has two jobs: answering requests, and background work (firing
# schedules, executing flows, cleaning up). One process does both by default.
# To use more than one core, split them: any number of `api` processes behind a
# load balancer, and one or more `orchestrator` processes that do only the
# background work and are not reached by the balancer. They share the work
# through the database: every schedule slot and every flow execution is taken
# by exactly one of them. One process tops out around 95 requests/s; three `api`
# replicas served 500 simulated users with a 95th percentile of 0.12 s where one
# process took 5.8 s.
#   all           one process, both jobs (default)
#   api           requests only
#   orchestrator  background work only
#APP__ROLE=all
# A flow execution is queued in the database and picked up by an orchestrator:
# how often each one looks at the queue, and how many executions one process
# carries at once (the rest wait in the queue).
#ORCHESTRATOR__QUEUE_POLL_SECONDS=1
#ORCHESTRATOR__MAX_CONCURRENT=20
# An execution still in the queue after this long (no orchestrator running, or
# all of them full) is not started any more: it is closed as failed.
#ORCHESTRATOR__QUEUE_TIMEOUT_SECONDS=900
# The process executing a flow says "still here" every HEARTBEAT seconds. An
# execution silent for longer than DEAD_AFTER belongs to a process that died:
# another orchestrator closes it as interrupted (its remaining steps are not
# run, and it is not resumed). Machines' clocks must agree within this margin.
#ORCHESTRATOR__HEARTBEAT_SECONDS=10
#ORCHESTRATOR__DEAD_AFTER_SECONDS=60

# ── Broker / cache index (Valkey) ────────────────────────────────────────────
REDIS__HOST=redis
REDIS__PORT=6379
REDIS__DB=0

# ── Object storage (any S3-compatible endpoint: MinIO, AWS S3, R2, B2…) ─────
STORAGE__ENDPOINT=http://minio:9000
STORAGE__ACCESS_KEY=minioadmin
# change in production
STORAGE__SECRET_KEY=minioadmin
STORAGE__BUCKET=data-prep
STORAGE__REGION=us-east-1
# The gateway keeps its own copy of the bucket name (ENGINE__BUCKET) and compares
# it against the bucket in every request, rejecting a mismatch with 403. The
# compose file derives it from STORAGE__BUCKET above, so changing that one value
# moves the whole stack; set ENGINE__BUCKET by hand only if you know why.

# Only if your broker requires authentication (managed Redis usually does).
#REDIS__PASSWORD=
# Celery follows REDIS__* above. Set these two only to point the queue somewhere
# else entirely (a separate broker, a different result store).
#CELERY__BROKER_URL=
#CELERY__RESULT_BACKEND=

# Origins allowed to call the API from a browser, as a JSON list. Needed only if
# the frontend is served from a different host than the gateway; same-host
# deployments can leave it alone.
#APP__CORS_ORIGINS=["https://app.example.com"]

# ── AI assistant (optional) ──────────────────────────────────────────────────
# A chat over the catalog, built with pydantic-ai against any OpenAI-compatible
# endpoint (Scaleway Generative APIs, OpenAI, a local vLLM…). The assistant only
# sees the datasources the signed-in user can read, runs read-only SELECTs
# through the engine, and every query is written to the audit log. Off until
# BASE_URL and SECRET_KEY are set. No model is usable until an administrator
# enables it in Admin → AI models. ACCESS_KEY is the id of the key (Scaleway);
# the protocol authenticates with the secret alone.
#AI__BASE_URL=https://api.scaleway.ai/v1
#AI__ACCESS_KEY=
#AI__SECRET_KEY=
# proposed first in the picker, if enabled
#AI__DEFAULT_MODEL=gpt-oss-120b
# rows a query of the assistant may return (to the model and to the chat)
#AI__MAX_RESULT_ROWS=200
# model round-trips per message: the cap on the tool-calling loop
#AI__MAX_REQUESTS=12
# Ceilings for ONE turn, applied by pydantic-ai itself. The round-trip cap above
# does not limit tokens, so without these a single question can cost anything.
#AI__MAX_COST_PER_TURN_USD=0.50
#AI__MAX_INPUT_TOKENS_PER_TURN=400000
# Tetto GIORNALIERO per utente, in dollari. Il tetto per turno non basta: mille
# turni sotto soglia costano mille volte. Indispensabile su un'installazione
# aperta a sconosciuti (una demo pubblica), dove ogni domanda passa dalla tua
# chiave. 0 = nessun tetto.
#AI__MAX_COST_PER_DAY_USD=2
# Daily ceiling for the WHOLE installation, in dollars. The per-user one above
# protects nothing where the account is SHARED — on a public demo everybody signs
# in as the same guest and there is one bill. Once reached, the assistant declares
# itself unavailable until the next day. 0 or absent = no ceiling.
#AI__MAX_COST_PER_DAY_TOTAL_USD=5
# How many past messages of a conversation are replayed to the model. Higher =
# the assistant remembers more and every turn costs more. Observers have no
# history at all, so this does not apply to them.
#AI__MAX_HISTORY_MESSAGES=60
# conversations kept in the list, per user (they are not deleted, only listed)
#AI__MAX_CHATS_LISTED=100

# ── Engine BigQuery (optional) ───────────────────────────────────────────────
# Runs the transformations on Google BigQuery. The parquet files stay in the
# bucket and are read as temporary EXTERNAL tables, so STORAGE__ENDPOINT must be
# Google Cloud Storage (https://storage.googleapis.com, HMAC keys). The service
# account needs "BigQuery Job User" on the project and read access on the bucket.
# Credentials: the JSON key as a file path inside the container OR base64 on one
# line (base64 -w0 key.json). LOCATION must be the bucket's region (or the
# multi-region containing it, e.g. EU); empty = read from the bucket.
# MAXIMUM_BYTES_BILLED caps the bytes billed per query (BigQuery refuses before
# running); 20 GiB ≈ 0.12 $ per query. 0 = no cap.
#BIGQUERY__PROJECT=my-gcp-project
#BIGQUERY__CREDENTIALS_FILE=/run/secrets/bigquery.json
#BIGQUERY__CREDENTIALS_B64=
#BIGQUERY__LOCATION=
#BIGQUERY__MAXIMUM_BYTES_BILLED=21474836480

# ── External ClickHouse engine (optional) ───────────────────────────────────
# Run flows on a remote ClickHouse server (cloud managed or self-hosted) instead
# of in the worker: same operations/dialect as chDB, but the work happens on the
# server. Disabled until HOST is set. Use the HTTP(S) port (8123 / 8443), NOT the
# native one (9000 / 9440).
#CLICKHOUSE_EXTERNAL__HOST=xxxx.datawarehouse.it-mil.scw.eu
#CLICKHOUSE_EXTERNAL__PORT=8443
#CLICKHOUSE_EXTERNAL__SECURE=true
#CLICKHOUSE_EXTERNAL__USERNAME=default
#CLICKHOUSE_EXTERNAL__PASSWORD=
# Dedicated, read-only ClickHouse user for the AI assistant's queries: a second
# barrier behind the SQL node allow-list. Used only when BOTH are set (and the
# transport is s3); otherwise the assistant runs as the user above.
# Grants it needs: docs/engines/clickhouse-ai-user.md
#CLICKHOUSE_EXTERNAL__AI_USERNAME=ai
#CLICKHOUSE_EXTERNAL__AI_PASSWORD=
# must exist; hosts staging tables in push mode
#CLICKHOUSE_EXTERNAL__DATABASE=default
# How the server reaches the data:
#   s3   → ClickHouse reads/writes parquet DIRECTLY on the object storage via s3():
#          nothing flows through the worker. Requires the storage to be reachable
#          from the server (e.g. ClickHouse + Object Storage on the same cloud).
#   push → the worker uploads the source into a staging table and streams the
#          result back: works with any ClickHouse, data transits the worker.
#CLICKHOUSE_EXTERNAL__TRANSPORT=s3
# Storage endpoint AS SEEN BY ClickHouse (s3 mode). Empty = STORAGE__ENDPOINT,
# which is right only when the server sits on the same network (http://minio:9000).
#CLICKHOUSE_EXTERNAL__S3_ENDPOINT=https://s3.fr-par.scw.cloud
# Optional: a named collection created ON THE SERVER with the S3 credentials, so
# keys never travel inside queries (nor end up in the query_log):
#   CREATE NAMED COLLECTION tabularia_s3 AS access_key_id = '…', secret_access_key = '…'
#CLICKHOUSE_EXTERNAL__S3_NAMED_COLLECTION=tabularia_s3
# Per-query execution cap in seconds (0 = none)
#CLICKHOUSE_EXTERNAL__MAX_EXECUTION_TIME=0
# Viewer speed-up (s3 mode only): a dataset the viewer reads that is larger than
# MATERIALIZE_MIN_ROWS is copied ONCE into a MergeTree table on the server, and
# later viewer queries read from it instead of re-reading the parquet via s3() —
# 2-6x faster on full scans (charts, pivots, sorts). 0 disables it. The copy
# lives in MATERIALIZE_DATABASE (empty = the working DATABASE) and is dropped
# after MATERIALIZE_TTL_SECONDS of no use. Best-effort: if the copy fails the
# viewer just stays on s3().
# OFF by default (0): the copy is built synchronously inside the request and a
# large table (25M rows x 50 columns) blew past the 60s ceiling on every Apply,
# wasting a minute before falling back to s3() anyway. With parquet written in
# large row groups (INGEST__PARQUET_ROW_GROUP_ROWS) direct reads are already
# fast. Set a row threshold > 0 to opt in.
#CLICKHOUSE_EXTERNAL__MATERIALIZE_MIN_ROWS=0
#CLICKHOUSE_EXTERNAL__MATERIALIZE_DATABASE=
#CLICKHOUSE_EXTERNAL__MATERIALIZE_TTL_SECONDS=1800
# Reading parquet from S3 is I/O-bound: ClickHouse defaults max_threads to the
# core count, too low while threads wait on the network. On scan-heavy queries
# (aggregations, pivots, sorts, joins) the engine raises it to at least this many
# threads to hide that latency — never below the server's cores, and never on
# LIMIT queries (the table view), which would slow down. 0 = leave max_threads alone.
#CLICKHOUSE_EXTERNAL__PARQUET_SCAN_MAX_THREADS=8

# ── Workers ──────────────────────────────────────────────────────────────────
CELERY__WORKER_CONCURRENCY=2

# ── How long a run may take ──────────────────────────────────────────────────
# These three are COUPLED. Changing one on its own does not do what it looks
# like it does, so they are declared together:
#
#   CELERY__TASK_TIME_LIMIT            the worker KILLS the task at this age.
#                                      This is the real ceiling on a run.
#   CELERY__TASK_SOFT_TIME_LIMIT       shortly before that the task gets an
#                                      exception instead, so it can close files
#                                      and report a failure (5 min of grace).
#   ENGINE__RUN_STALE_TIMEOUT_SECONDS  the gateway declares a run that never
#                                      reached a terminal state LOST and marks it
#                                      FAILURE. Must stay ABOVE the hard limit,
#                                      so the gateway only gives up after Celery
#                                      has actually killed the task.
#
# To allow longer runs, raise the hard limit AND the stale timeout together.
# Raising the stale timeout alone only makes you wait longer to be told the run
# died at the hard limit.
CELERY__TASK_TIME_LIMIT=3600
CELERY__TASK_SOFT_TIME_LIMIT=3300
ENGINE__RUN_STALE_TIMEOUT_SECONDS=3900

# Ceiling on an interactive preview: the engine API submits it to the `preview`
# queue and waits this long for a worker, then revokes the job and answers 504.
# Keep any reverse-proxy read timeout above this value.
PREVIEW_TIMEOUT_SECONDS=120

# ── Incremental step cache ───────────────────────────────────────────────────
# evict entries unused for 1 day
CACHE__TTL_SECONDS=86400
# eviction sweep every hour
CACHE__SWEEP_INTERVAL_SECONDS=3600

# ── Monitoring (Grafana admin) ───────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
# change in production
GRAFANA_ADMIN_PASSWORD=admin

# ── Metadata database (Postgres) ─────────────────────────────────────────────
DB__USER=tabularia
# change in production
DB__PASSWORD=tabularia
DB__NAME=tabularia
DB__HOST=postgres
DB__PORT=5432
# Full DSN, for a managed Postgres that does not fit the pieces above. When set,
# it wins over HOST/PORT/USER/PASSWORD/NAME.
#DB__URL=postgresql://user:password@host:5432/dbname
# Connections the gateway keeps open to Postgres. Unset = one per gateway
# thread (APP__GATEWAY_THREADS below), which is what it needs; lower, and the
# missing ones are opened and closed at every request. On top of these it keeps
# a quarter as many for the one-statement read of the signed-in user.
# DB__MAX_OVERFLOW is how many more it may open at a peak (closed when returned).
# Pool + overflow must stay under Postgres' max_connections (100 by default),
# summed over every gateway process: with 40 threads one process may open up to
# 60 (40 + a quarter for the user read + the overflow), so several replicas need
# fewer threads each or a larger max_connections.
#DB__POOL_SIZE=
#DB__MAX_OVERFLOW=10

# ── Auth (gateway) ───────────────────────────────────────────────────────────
# Generate a strong secret:  openssl rand -hex 32
# In production the gateway REFUSES to start with the dev defaults below.
JWT__SECRET=change-me-in-production
JWT__ACCESS_TTL_MINUTES=720

# Initial admin user, seeded at first startup (existing users are never touched)
AUTH__ADMIN_EMAIL=admin@tabularia.local
# change in production
AUTH__ADMIN_PASSWORD=admin
AUTH__ADMIN_NAME=Administrator

# ── SSO / OIDC (OPTIONAL: Keycloak, Microsoft Entra ID, Auth0, Okta…) ───────
# Leave OIDC__ISSUER empty to keep local email+password login only: the SSO
# routes stay off and the login page shows no SSO button. When set, the gateway
# self-configures from ${OIDC__ISSUER}/.well-known/openid-configuration and
# refuses to start if the rest of the block is incomplete.
# Runnable Keycloak example: docs/examples/keycloak/
#OIDC__ISSUER=http://localhost:8080/realms/tabularia
#   Entra ID: https://login.microsoftonline.com/<tenant-id>/v2.0
#OIDC__CLIENT_ID=tabularia-gateway
# confidential client, rotate for real use
#OIDC__CLIENT_SECRET=
# must match the IdP
#OIDC__REDIRECT_URI=http://localhost:8000/auth/sso/callback
# frontend landing page
#OIDC__POST_LOGIN_URL=http://localhost:3000/auth/callback
#OIDC__SCOPES=openid profile email
# 'roles' for Entra app roles
#OIDC__GROUPS_CLAIM=groups
# comma-separated; empty = every IdP group
#OIDC__GROUP_ALLOWLIST=
# false = map only onto existing groups
#OIDC__AUTO_CREATE_GROUPS=false
# true = the IdP owns group membership
#OIDC__AUTHORITATIVE=true
# membership grants is_superuser
#OIDC__SUPERUSER_GROUP=tabularia-admins
# Who may SIGN IN at all — a different question from which groups they receive.
# Both are off by default, so nothing changes for an existing setup. Without
# them, everyone the IdP authenticates gets an active account: if the issuer is
# the company directory, that is the whole company.
# comma-separated domains; empty = any
#OIDC__ALLOWED_EMAIL_DOMAINS=azienda.it
# true = signing in requires a group listed in OIDC__GROUP_ALLOWLIST
#OIDC__REQUIRE_ALLOWLISTED_GROUP=false
#OIDC__BUTTON_LABEL=Single sign-on

# ── Database-connection credentials encryption (gateway + engine) ───────────
# Shared Fernet key: the gateway encrypts DB-connection passwords at rest and
# sends them still encrypted to the engine, which decrypts them only inside the
# worker. REQUIRED in EVERY environment, development included: `docker compose up`
# refuses to start without it, and gateway/engine/workers refuse an invalid one.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECURITY__FERNET_KEY=

# ── Internal engine URL (data plane, proxied by the gateway) ─────────────────
ENGINE__BASE_URL=http://backend:8000

# ── Parquet written by the database ingest ──────────────────────────────────
# Rows per ROW GROUP. The writer used to emit one row group per driver batch
# (~8k rows): a 25M-row, 50-column table ended up with 3063 row groups and a
# 16.6 MB footer. With blocks that small, reading two columns out of fifty would
# take thousands of tiny ranged requests, so the engine downloads the whole file
# instead — the per-column pruning parquet exists for never pays off.
# Raising this costs MEMORY: the block is buffered in RAM before being written
# (~570 MB per 1M rows of a 50-column table), so keep WORKER_MEM_LIMIT in step.
INGEST__PARQUET_ROW_GROUP_ROWS=1000000

# ── Container memory ceilings ───────────────────────────────────────────────
# Ceilings, not reservations. memswap_limit is pinned to the same value in the
# compose file so a runaway container is OOM-killed instead of swap-thrashing
# the host. Keep the SUM below the machine's RAM: past that, the host OOM-killer
# picks the victim, and it may well be the database rather than the worker.
WORKER_MEM_LIMIT=6g
PREVIEW_WORKER_MEM_LIMIT=4g

# Preview worker processes. Previews are short and light (the heavy lifting is
# on ClickHouse/S3, the worker decodes a few hundred rows), so more of them
# mainly means several people can open the viewer at once without queueing.
# The per-child memory cap is derived as PREVIEW_WORKER_MEM_LIMIT / concurrency
# (floor 512 MB), so keep the two in step: 4g / 4 = 1 GiB per child.
PREVIEW_WORKER_CONCURRENCY=4
BACKEND_MEM_LIMIT=4g


# ── SharePoint source ─────────────────────────────────────────────────────────
# Excel files on SharePoint are read through Microsoft Graph with an app
# registered on Entra ID (client credentials; ask IT for the Sites.Selected
# permission and a grant on the specific site). Tenant, client id, secret and
# site URL live in the CONNECTION, not here. Override these two only on a
# sovereign cloud (US Gov: https://graph.microsoft.us/v1.0 and
# https://login.microsoftonline.us). They are deployment settings on purpose:
# whoever creates a connection cannot point the backend at an arbitrary host.
#SHAREPOINT__GRAPH_BASE=https://graph.microsoft.com/v1.0
#SHAREPOINT__LOGIN_BASE=https://login.microsoftonline.com


# ── Audit retention ───────────────────────────────────────────────────────────
# The audit log is append-only: no route deletes from it, and deleting an account
# does not delete what that account did. That is deliberate — but "forever" is the
# absence of a retention policy rather than one, and on an installation open to
# strangers it means holding other people's records with no reason that expires.
#
# With a value > 0, entries older than that many MINUTES are deleted by the
# gateway, once a minute. Minutes because on a public demo the useful window is an
# hour, not a year. 0 or absent = keep everything, which is what every existing
# installation does today.
#   60    = one hour (public demo)
#   43200 = thirty days
#AUDIT__RETENTION_MINUTES=0


# ── Sample data ───────────────────────────────────────────────────────────────
# Two fake external databases (an ERP on Postgres, a CRM on ClickHouse) plus an
# init container that fills them and builds the «Sample» folder in Tabularia:
# connections, a dozen tables (some described, some not — on purpose), eleven
# flows (three scheduled), and saved views. Who gets to see it is the
# administrator's call: the folder is created with no permissions on it.
# The switch is a compose PROFILE, which is the only thing compose can turn a
# container on with; a plain INCLUDE_SAMPLES=true variable cannot.
#COMPOSE_PROFILES=samples
# small (seconds, fits a laptop) | medium | robusta (42M order lines, minutes and
# a few GB). Generated once: the init container skips it when data is there.
#SAMPLES_SCALE=small
# Engine for the sample flows. Empty = the first engine the policy allows, in the
# order polars, duckdb, chdb, clickhouse, bigquery.
#SAMPLES_ENGINE=
# Run the flows once at init so their output tables and the views exist.
#SAMPLES_RUN_FLOWS=true


# ── Rarely changed, documented so they are not a surprise ─────────────────────
# These all have working defaults; the values shown ARE the defaults. Listed
# because they exist and someone will eventually need one of them.

# Threads that serve requests. The two services read this same file and want
# opposite values, hence two names.
# Gateway: more threads do not serve more — Python runs one at a time and they
# only contend (measured at 500 users: 68 requests/s with 40, 79 with 6).
#APP__GATEWAY_THREADS=40
# Engine API: every preview in progress holds one thread for its whole duration
# while it waits for a worker, so this is how many previews can be open at once.
# They sleep, they cost little. Minimum 40.
#APP__ENGINE_API_THREADS=200

# How many flow runs one worker is assumed to carry at once. It is what the
# scheduler uses to plan the queue, not a hard limit.
#SCHEDULING__WORKER_CAPACITY=2

# Celery workers recycle after this many tasks, and after this much resident
# memory, to keep a leak from growing without bound. PER_CHILD_KB empty = worked
# out from the container's memory limit times HEADROOM_FRAC, never below FLOOR.
#CELERY__MAX_TASKS_PER_CHILD=50
#CELERY__MAX_MEMORY_HEADROOM_FRAC=0.75
#CELERY__MAX_MEMORY_PER_CHILD_KB=
#CELERY__MAX_MEMORY_PER_CHILD_FLOOR_KB=512000

# Seconds to wait for the external ClickHouse to answer the handshake.
#CLICKHOUSE_EXTERNAL__CONNECT_TIMEOUT=10

# Dataset BigQuery writes its step cache into (expiring tables).
#BIGQUERY__CACHE_DATASET=tabularia_cache

# Where the Monitoring panel reads host metrics from, and how long it caches
# them. Point NODE_EXPORTER_URL elsewhere if you run your own exporter.
#MONITORING__NODE_EXPORTER_URL=http://node-exporter:9100/metrics
#MONITORING__CACHE_SECONDS=3
#MONITORING__TIMEOUT_SECONDS=3

# How often the storage size is measured and published as a metric.
#METRICS__STORAGE_STATS_INTERVAL_SECONDS=60

# SSO timings: how long the discovery document is trusted, how long a login
# transaction may stay open, how long the IdP has to answer.
#OIDC__DISCOVERY_TTL_SECONDS=3600
#OIDC__LOGIN_TX_TTL_SECONDS=600
#OIDC__TIMEOUT_SECONDS=10

# Not listed on purpose: APP__NAME / APP__VERSION / APP__CODENAME (product
# identity, not deployment), JWT__ALGORITHM and the CELERY__*_SERIALIZER /
# ENABLE_UTC / TIMEZONE knobs (changing them breaks the workers — the JSON
# serializer is a security property, see docs/audit), ENGINE__BUCKET (compose
# derives it from STORAGE__BUCKET so the two cannot drift apart).
